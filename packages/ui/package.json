{
  "name": "@randomtask/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --passWithNoTests .integration.test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@randomtask/core": "*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
