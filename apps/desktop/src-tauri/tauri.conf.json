{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "randomnote",
  "version": "../package.json",
  "identifier": "engineering.swords.randomnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "randomnote",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
